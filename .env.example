PORT=3000
HOST=0.0.0.0
CONTACT_EMAIL=henrik@henriktelle.com
DB_PATH=./data/subscribers.sqlite
ADMIN_TOKEN=change-me-long-random-token

# GoHighLevel / LeadConnector newsletter CRM sync
# Create a GHL private integration token with contacts write access for the Plates & Profit sub-account.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_NEWSLETTER_TAG=plates-profit-newsletter
GHL_WELCOME_TAG=plates-profit-welcome-email
GHL_SOURCE=henriktelle.com
GHL_API_BASE=https://services.leadconnectorhq.com

# Optional SMTP notifications + optional direct welcome email fallback.
# Default welcome flow is GHL: create a GHL workflow triggered by tag GHL_WELCOME_TAG.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Plates & Profit <henrik@henriktelle.com>
SEND_WELCOME_EMAIL=false
